{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WaveRoot Track C report proposal 0.1",
  "description": "Synthetic-fixture proposal. Reconcile with the canonical team model before production use. Cross-reference, bit-width, source-hash and timing rules require semantic validation.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "track-c-proposal-0.1"
    },
    "provenance": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "synthetic_fixture"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "case_id",
        "note"
      ],
      "additionalProperties": false
    },
    "status": {
      "enum": [
        "pass",
        "fail",
        "inconclusive",
        "unsupported",
        "error"
      ]
    },
    "failure": {
      "anyOf": [
        {
          "$ref": "#/$defs/failure"
        },
        {
          "type": "null"
        }
      ]
    },
    "nodes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/edge"
      }
    },
    "suspects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/suspect"
      }
    },
    "waveform": {
      "$ref": "#/$defs/waveform"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "assertions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assertion"
      }
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/diagnostic"
      }
    }
  },
  "required": [
    "schema_version",
    "provenance",
    "status",
    "failure",
    "nodes",
    "edges",
    "suspects",
    "waveform",
    "sources",
    "assertions",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "tick": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "value": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "bits": {
          "type": "string",
          "pattern": "^[01xz]+$"
        }
      },
      "required": [
        "width",
        "bits"
      ],
      "additionalProperties": false
    },
    "observation": {
      "type": "object",
      "properties": {
        "epoch": {
          "type": "integer",
          "minimum": 0
        },
        "cycle": {
          "type": "integer",
          "minimum": 0
        },
        "phase": {
          "enum": [
            "pre_edge",
            "post_settle"
          ]
        },
        "time_tick": {
          "$ref": "#/$defs/tick"
        }
      },
      "required": [
        "epoch",
        "cycle",
        "phase",
        "time_tick"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "end_line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "source_id",
        "line",
        "end_line"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "value_mismatch",
            "unknown_value",
            "missing_transaction",
            "extra_transaction",
            "protocol_violation"
          ]
        },
        "signal_id": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "actual": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "signal_id",
        "observation",
        "expected",
        "actual",
        "explanation"
      ],
      "additionalProperties": false
    },
    "node": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "signal_id": {
          "type": "string",
          "minLength": 1
        },
        "observation": {
          "$ref": "#/$defs/observation"
        },
        "value": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "signal_id",
        "observation",
        "value",
        "location"
      ],
      "additionalProperties": false
    },
    "edge": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "combinational",
            "sequential"
          ]
        },
        "branch": {
          "enum": [
            "retained",
            "pruned",
            "unknown"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "kind",
        "branch",
        "reason"
      ],
      "additionalProperties": false
    },
    "suspect": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "rank": {
          "type": "integer",
          "minimum": 1
        },
        "node_id": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "evidence_node_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/location"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "rank",
        "node_id",
        "reason",
        "evidence_node_ids",
        "location"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "time_tick": {
          "$ref": "#/$defs/tick"
        },
        "value": {
          "$ref": "#/$defs/value"
        }
      },
      "required": [
        "time_tick",
        "value"
      ],
      "additionalProperties": false
    },
    "signal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "availability": {
          "enum": [
            "available",
            "missing"
          ]
        },
        "initial": {
          "anyOf": [
            {
              "$ref": "#/$defs/value"
            },
            {
              "type": "null"
            }
          ]
        },
        "transitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transition"
          }
        }
      },
      "required": [
        "id",
        "width",
        "availability",
        "initial",
        "transitions"
      ],
      "additionalProperties": false
    },
    "waveform": {
      "type": "object",
      "properties": {
        "tick_unit": {
          "const": "ps"
        },
        "start_tick": {
          "$ref": "#/$defs/tick"
        },
        "end_tick": {
          "$ref": "#/$defs/tick"
        },
        "signals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signal"
          }
        }
      },
      "required": [
        "tick_unit",
        "start_tick",
        "end_tick",
        "signals"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "path",
        "sha256",
        "content"
      ],
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "validation": {
          "enum": [
            "candidate",
            "validated",
            "failed",
            "unsupported"
          ]
        },
        "tool": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "result_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "text",
        "validation",
        "tool",
        "result_ref"
      ],
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  }
}
