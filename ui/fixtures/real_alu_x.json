        "text": "// WaveRoot candidate assertion a1. Not validated: it restates one\n// trace observation and the golden expected value. Review before relying on it.\n// Failure: tb.dut.out_data expected 8'b00000000, observed 8'bxxxxxxxx at 25000 ps\n//   (epoch 0, cycle 0, settled).\n// Top suspect: tb.dut.out_data (rtl/mutant/alu.sv:26).\n// Cause terms (operands the suspect consumed): sel_q, b, a, in_valid.\nmodule waveroot_chk_a1 (\n  input logic clk,\n  input logic rst_n,\n  input logic sel_q,\n  input logic [7:0] b,\n  input logic [7:0] a,\n  input logic in_valid,\n  input logic [7:0] out_data\n);\n  property p_waveroot_a1;\n    @(posedge clk) disable iff (rst_n !== 1'b1)\n    ((sel_q === 1'bx) && (b === 8'b11111111) && (a === 8'b00000000) && (in_valid === 1'b1))\n    |=> (!$isunknown(out_data) && (out_data == 8'b00000000));\n  endproperty\n  a_waveroot_a1: assert property (p_waveroot_a1);\n  c_waveroot_a1: cover property (@(posedge clk) disable iff (rst_n !== 1'b1) ((sel_q === 1'bx) && (b === 8'b11111111) && (a === 8'b00000000) && (in_valid === 1'b1)));\nendmodule\nbind alu waveroot_chk_a1 u_waveroot_chk_a1 (.clk(clk), .rst_n(rst_n), .sel_q(sel_q), .b(b), .a(a), .in_valid(in_valid), .out_data(out_data));\n",
